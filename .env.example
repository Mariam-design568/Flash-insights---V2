LLM_API_KEY=
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-3.8-flash

# RSS is the only external collection source; it requires no API key.
ENABLED_CONNECTORS=rss
# RSS_FEEDS=https://example.org/feed.xml|1|Example feed
COLLECT_INTERVAL_SECONDS=300
COLLECTOR_MAX_ITEMS_PER_RUN=10
LLM_MIN_REQUEST_INTERVAL_SECONDS=15
